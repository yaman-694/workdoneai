# Cloudflare Turnstile bot check on the contact form (Cloudflare dashboard > Turnstile).
# For local dev you can use Cloudflare's always-pass test keys:
#   site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# n8n webhook that stores and emails contact form submissions. Server-only, never sent to the browser.
CONTACT_WEBHOOK_URL=
# Shared secret sent as the X-Webhook-Secret header; must match the n8n Header Auth credential.
# Generate with: openssl rand -hex 32
CONTACT_WEBHOOK_SECRET=
