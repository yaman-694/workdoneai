---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader/opsz.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileCta from '../components/MobileCta.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Header starts transparent over a dark hero. */
  overlayHeader?: boolean;
}

const { title, description, noindex, overlayHeader = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#3b3650" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO title={title} description={description} noindex={noindex} />
    <slot name="head" />
    <!-- Hide animated elements only when motion will actually run, so content never stays hidden. -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
        // Failsafe: if scripts never start, show everything.
        setTimeout(function () {
          if (!document.documentElement.classList.contains('motion-ready')) {
            document.documentElement.classList.remove('motion');
          }
        }, 3000);
      }
    </script>
    <style is:global>
      html.motion [data-reveal],
      html.motion [data-reveal-stagger] > * {
        opacity: 0;
      }
      html.motion [data-split] {
        visibility: hidden;
      }
      [id] {
        scroll-margin-top: 4.5rem;
      }
    </style>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-[70] rounded bg-text px-4 py-3 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to content</a
    >
    <Header overlay={overlayHeader} />
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main id="main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <MobileCta />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
