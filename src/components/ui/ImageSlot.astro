---
/**
 * A photo slot. Until real photography exists it renders a labelled placeholder;
 * pass `src` (an imported image) to render an optimised <Image> instead.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  label: string;
  src?: ImageMetadata;
  alt?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const { label, src, alt = '', eager = false, sizes = '100vw', class: className = '' } = Astro.props;
---

{
  src ? (
    <Image
      src={src}
      alt={alt}
      sizes={sizes}
      widths={[480, 800, 1200, 1600, 2400]}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class:list={['h-full w-full object-cover', className]}
      data-media
    />
  ) : (
    <div
      class:list={['relative h-full w-full overflow-hidden bg-plum', className]}
      role="img"
      aria-label={alt || label}
      data-media
    >
      <div class="absolute inset-0 bg-[radial-gradient(120%_80%_at_80%_10%,#a09abc_0%,#4a4370_45%,#3b3650_100%)]"></div>
    </div>
  )
}
