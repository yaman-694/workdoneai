---
import { nav, site } from '../data/site';

const links = [...nav, { label: 'Contact', href: '/contact' }];
const legal = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
];
const year = new Date().getFullYear();
---

<footer class="bg-text pt-20 pb-10 text-white lg:pt-24">
  <div class="container-x flex flex-col gap-16 lg:gap-20">
    <div class="flex flex-col justify-between gap-12 lg:flex-row">
      <div class="flex flex-col gap-3">
        <a href="/" class="font-serif text-5xl tracking-[-0.03em] lg:text-7xl">{site.name}</a>
        <p class="text-lavender">{site.tagline}</p>
      </div>
      <div class="grid grid-cols-2 gap-x-16 gap-y-3 text-[0.9375rem]">
        <ul class="flex flex-col gap-3">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-lavender">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="flex flex-col gap-3">
          {
            legal.map((link) => (
              <li>
                <a href={link.href} class="hover:text-lavender">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="border-t border-white/20 pt-6 text-[0.8125rem] text-white/70">© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>
