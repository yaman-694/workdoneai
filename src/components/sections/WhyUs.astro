---
import { reasons } from '../../data/site';
---

<section class="bg-lavender-light py-24 lg:py-36" aria-labelledby="why-title">
  <div class="container-x flex flex-col gap-12 lg:gap-16">
    <h2 id="why-title" class="text-h1 max-w-[20ch]" data-split>Not another tool. A system built around your business.</h2>
    <ul class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        reasons.map((reason) => (
          <li class="flex flex-col gap-3.5 border-t border-text pt-6">
            <h3 class="text-h3">{reason.title}</h3>
            <p class="text-[0.9375rem] leading-relaxed">{reason.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
