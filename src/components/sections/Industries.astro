---
import { industries } from '../../data/site';
import CarouselControls from '../ui/CarouselControls.astro';
import Icon from '../ui/Icon.astro';
import ImageSlot from '../ui/ImageSlot.astro';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="industries" class="overflow-hidden bg-paper py-24 lg:py-36" aria-labelledby="industries-title" data-carousel>
  <div class="container-x flex flex-col gap-10 lg:gap-14">
    <p id="industries-title" class="max-w-[24ch] font-serif text-[clamp(2rem,4.2vw,4rem)] leading-[1.08] tracking-[-0.03em]" data-split>
      Built around your business. Every workflow is shaped to how <span class="text-ink">your</span> industry actually runs.
    </p>
    <div class="flex items-end justify-between gap-6">
      <p class="eyebrow" data-carousel-count>01 / {pad(industries.length)}</p>
      <CarouselControls label="industry" />
    </div>
  </div>

  <ul
    class="no-scrollbar mt-6 flex snap-x snap-mandatory scroll-ps-5 gap-4 overflow-x-auto ps-5 sm:scroll-ps-8 sm:ps-8 lg:mt-8 lg:scroll-ps-[max(72px,calc((100vw-1440px)/2+72px))] lg:gap-5 lg:ps-[max(72px,calc((100vw-1440px)/2+72px))]"
    data-carousel-track
  >
    {
      industries.map((industry) => (
        <li class="w-[88vw] shrink-0 snap-start lg:w-[min(1100px,78vw)]" data-slide>
          <article class="relative isolate flex h-[min(78svh,560px)] flex-col justify-end overflow-hidden rounded-[4px] text-white lg:h-[min(80svh,680px)]">
            <div class="absolute inset-0 -z-10">
              <ImageSlot label={industry.image} sizes="(min-width: 1024px) 1100px, 88vw" />
            </div>
            <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(23,23,23,0)_30%,rgba(23,23,23,0.75)_100%)]"></div>
            <div class="flex flex-col gap-3 p-6 lg:gap-5 lg:p-14">
              <h3 class="text-display">{industry.name}</h3>
              <div class="flex flex-col gap-2 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
                <p class="text-lead max-w-[32rem]">{industry.text}</p>
                <p class="text-white/90">
                  Typical saving: <span class="font-serif text-2xl">[X hrs / week]</span>
                </p>
              </div>
            </div>
          </article>
        </li>
      ))
    }
    <li class="w-px shrink-0 lg:w-[max(72px,calc((100vw-1440px)/2+72px))]" aria-hidden="true"></li>
  </ul>

  <div class="container-x mt-8 flex flex-col gap-10 lg:mt-10">
    <div class="relative h-0.5 bg-line" aria-hidden="true">
      <div class="absolute inset-y-0 left-0 w-0 bg-text" data-carousel-progress></div>
    </div>
    <a href="#contact" class="btn btn-outline self-start">
      Explore Your Industry
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>
