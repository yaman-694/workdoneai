---
import { demos, demoVideo } from '../../data/site';
import Icon from '../ui/Icon.astro';

const tryItSteps = ['Message Arav on Telegram', 'Answer its questions like a buyer', 'See your lead land in the CRM'];
---

<section id="demo" class="scroll-mt-20 bg-plum py-24 text-white lg:py-36" aria-labelledby="demo-title">
  <div class="container-x flex flex-col gap-12 lg:gap-16">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <h2 id="demo-title" class="text-h1 max-w-[16ch]" data-split>
        Don't take our word for it. <span class="text-lavender">Try it live.</span>
      </h2>
      <ol class="flex flex-col gap-2.5 text-[0.9375rem] text-white/85 lg:max-w-[22rem]" data-reveal>
        {
          tryItSteps.map((step, i) => (
            <li class="flex gap-3">
              <span class="font-serif text-lavender">{i + 1}.</span>
              {step}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="flex flex-col gap-4" data-demo-video>
      <figure
        class="relative overflow-hidden rounded-[4px] border border-white/25 bg-plum max-sm:mx-auto max-sm:w-[min(100%,calc(78svh*9/16))]"
        data-demo-frame
      >
        <video
          class="block aspect-video w-full object-cover max-sm:aspect-[9/16]"
          data-mobile-poster="/videos/arav-demo-vertical-poster.jpg"
          data-mobile-sources="/videos/arav-demo-vertical.webm,/videos/arav-demo-vertical.mp4"
          poster="/videos/arav-demo-poster.jpg"
          muted
          loop
          playsinline
          preload="none"
          aria-label="One-minute walkthrough: Arav qualifies a property buyer on Telegram, alerts the sales team and books a site visit"
        >
          <source src="/videos/arav-demo.webm" type="video/webm" />
          <source src="/videos/arav-demo.mp4" type="video/mp4" />
        </video>

        <p
          class="absolute top-3 left-3 hidden items-center gap-2 rounded-full sm:flex bg-plum/80 px-3 py-1.5 text-[0.75rem] tracking-[0.08em] text-white uppercase opacity-0 backdrop-blur-sm sm:top-5 sm:left-5"
          data-demo-live
        >
          <span class="relative flex size-2">
            <span class="absolute inset-0 rounded-full bg-[#7fd18b]" data-live-pulse></span>
            <span class="relative size-2 rounded-full bg-[#7fd18b]"></span>
          </span>
          Now playing
        </p>

        <button
          type="button"
          class="absolute inset-0 hidden place-items-center bg-plum/30 text-white"
          data-demo-play
          aria-label="Play the demo video"
        >
          <span class="grid size-20 place-items-center rounded-full bg-lavender text-plum lg:size-24">
            <Icon name="play" size={32} />
          </span>
        </button>

        <button
          type="button"
          class="absolute top-1/2 left-1/2 flex -translate-1/2 items-center gap-3 rounded-full bg-lavender py-3 pr-6 pl-3.5 text-[0.9375rem] font-medium whitespace-nowrap text-plum shadow-[0_12px_40px_rgba(20,17,32,0.5)] sm:top-auto sm:right-6 sm:bottom-6 sm:left-auto sm:translate-0"
          data-sound-cta
        >
          <span class="pointer-events-none absolute inset-0 rounded-full border-2 border-lavender" aria-hidden="true" data-sound-ripple></span>
          <span class="pointer-events-none absolute inset-0 rounded-full border-2 border-lavender" aria-hidden="true" data-sound-ripple></span>
          <span class="grid size-8 place-items-center rounded-full bg-plum text-lavender" aria-hidden="true">
            <Icon name="volume-off" size={17} />
          </span>
          Tap for sound
        </button>

        <button
          type="button"
          class="absolute top-2.5 right-2.5 grid size-10 place-items-center rounded-full bg-plum/80 text-lavender backdrop-blur-sm hover:bg-plum sm:top-auto sm:right-6 sm:bottom-6 sm:size-12"
          aria-label="Mute the demo video"
          hidden
          data-sound-mute
        >
          <span class="flex h-4 items-end gap-[3px]" aria-hidden="true">
            {[0, 1, 2, 3].map(() => <span class="h-full w-[3px] origin-bottom rounded-full bg-lavender" data-eq></span>)}
          </span>
        </button>
      </figure>

      <ol class="grid grid-cols-6 gap-1.5 sm:gap-3" aria-label="Video chapters" data-chapters>
        {
          demoVideo.chapters.map((chapter, i) => (
            <li>
              <button
                type="button"
                class="group flex w-full flex-col gap-2 pt-1 text-left"
                data-chapter
                data-start={chapter.start}
                aria-label={`Jump to ${chapter.label}`}
              >
                <span class="relative block h-[3px] w-full overflow-hidden rounded-full bg-white/20">
                  <span class="absolute inset-0 origin-left scale-x-0 rounded-full bg-lavender" data-chapter-fill></span>
                </span>
                <span class="flex items-baseline gap-1.5 text-[0.6875rem] text-white/55 transition-colors duration-300 group-hover:text-white group-data-active:text-white sm:text-[0.8125rem]">
                  <span class="hidden font-serif text-lavender sm:inline">{String(i + 1).padStart(2, '0')}</span>
                  {chapter.label}
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <ul class="grid gap-5 lg:grid-cols-2" data-reveal-stagger>
      {
        demos.map((demo, i) => (
          <li>
            <article class="flex h-full flex-col gap-7 rounded-[4px] border border-white/25 p-6 lg:p-10">
              <div class="flex items-center justify-between gap-4">
                <p class="eyebrow text-lavender-light">{demo.kind}</p>
                <p class="flex items-center gap-2 text-[0.8125rem] text-white/85">
                  <span class="size-2 rounded-full bg-[#7fd18b]" aria-hidden="true"></span>
                  Live
                </p>
              </div>
              <div class="flex flex-col gap-3">
                <h3 class="font-serif text-[2.5rem] leading-none tracking-[-0.03em] lg:text-[3.25rem]">{demo.name}</h3>
                <p class="text-lead max-w-[30rem] text-white/90">{demo.text}</p>
              </div>
              <ul class="flex flex-col gap-2.5 border-t border-white/25 pt-6">
                {demo.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <Icon name="check" size={20} class="mt-0.5 shrink-0 text-lavender" />
                    {feature}
                  </li>
                ))}
              </ul>
              <a
                href={demo.href}
                target="_blank"
                rel="noopener"
                class:list={['btn mt-auto self-start', i === 0 ? 'btn-primary' : 'btn-outline-light']}
              >
                {demo.action}
                <Icon name="arrow-up-right" size={18} />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </article>
          </li>
        ))
      }
    </ul>
    <p class="-mt-6 text-sm text-white/75 lg:-mt-10">
      This is a shared demo: anything you tell Arav shows up in the public CRM, so use made-up details.
      <a href="/privacy" class="underline underline-offset-2 hover:text-white">Privacy Policy</a>
    </p>
  </div>
</section>
