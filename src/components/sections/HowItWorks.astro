---
import Icon from '../ui/Icon.astro';
import { processSteps } from '../../data/site';
---

<section id="how-it-works" class="container-x py-24 lg:py-36" aria-labelledby="how-title">
  <div class="flex flex-col gap-6 border-y border-text py-6 sm:flex-row sm:items-center sm:justify-between">
    <h2 id="how-title" class="text-h3 max-w-[22ch]">Simple for you. Powerful behind the scenes.</h2>
    <a href="#contact" class="btn btn-outline self-start sm:self-auto">
      <Icon name="arrow-right" size={18} />
      Book an Intro Call
    </a>
  </div>
  <ol>
    {
      processSteps.map((step) => (
        <li class="grid grid-cols-[3.5rem_1fr] gap-x-4 gap-y-3 border-b border-text py-10 lg:grid-cols-4 lg:gap-8 lg:py-14" data-reveal>
          <span class="font-serif text-[1.75rem] leading-tight lg:text-[2.5rem]">{step.num}</span>
          <h3 class="text-h3">{step.title}</h3>
          <p class="col-start-2 text-lead lg:col-span-2 lg:col-start-auto">{step.text}</p>
        </li>
      ))
    }
  </ol>
</section>
