---
import { flows } from '../../data/site';
import Icon from '../ui/Icon.astro';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="container-x py-24 lg:py-36" aria-labelledby="showcase-title" data-showcase>
  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <h2 id="showcase-title" class="text-h1" data-split>
      See automation <span class="text-ink">in action.</span>
    </h2>
    <p class="text-lead max-w-[24rem]" data-reveal>Pick a workflow and watch one lead run from first message to done.</p>
  </div>

  <div class="mt-10 flex flex-col gap-6 lg:mt-14 lg:flex-row lg:gap-12">
    <div
      class="no-scrollbar -mx-5 flex gap-2 overflow-x-auto px-5 sm:mx-0 sm:px-0 lg:w-[32%] lg:shrink-0 lg:flex-col lg:gap-0 lg:overflow-visible lg:border-b lg:border-text"
      role="tablist"
      aria-label="Example real estate workflows"
      data-tablist
    >
      {
        flows.map((flow, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${flow.id}`}
            aria-controls={`panel-${flow.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="group min-h-11 shrink-0 rounded-full border border-text px-5 text-[0.9375rem] transition-colors aria-selected:bg-text aria-selected:text-white lg:grid lg:min-h-0 lg:grid-cols-[3rem_1fr_2rem] lg:items-baseline lg:rounded-none lg:border-0 lg:border-t lg:px-0 lg:py-7 lg:text-left lg:font-serif lg:text-[clamp(2rem,3.4vw,3rem)] lg:leading-none lg:tracking-[-0.03em] lg:text-[#8a8699] lg:hover:text-text lg:aria-selected:bg-transparent lg:aria-selected:text-ink"
            data-tab
          >
            <span class="hidden font-sans text-sm tracking-[0.04em] lg:inline">{pad(i + 1)}</span>
            <span>{flow.label}</span>
            <span class="hidden justify-self-end self-center lg:group-aria-selected:inline-flex" aria-hidden="true"><Icon name="arrow-right" size={28} /></span>
          </button>
        ))
      }
    </div>

    <div class="min-w-0 flex-1">
      {
        flows.map((flow, i) => (
          <div
            id={`panel-${flow.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${flow.id}`}
            class="flex flex-col gap-8 rounded-[4px] bg-lavender-light p-6 sm:p-10 lg:gap-10 lg:p-12"
            hidden={i !== 0}
            data-panel
          >
            <div class="flex flex-wrap justify-between gap-3">
              <p class="eyebrow">{flow.title}</p>
              <p class="eyebrow hidden sm:block">Trigger → Process → Actions → Result</p>
            </div>

            <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-12">
              <ol class="relative flex flex-col gap-3.5 pl-11" data-flow>
                <span class="absolute top-3.5 bottom-3.5 left-[11px] w-px bg-ink/35" aria-hidden="true"></span>
                {flow.steps.map((step, s) => {
                  const last = s === flow.steps.length - 1;
                  return (
                    <li class="relative flex min-h-6 items-center">
                      <span
                        class:list={[
                          'absolute top-1/2 -left-11 size-6 -translate-y-1/2 rounded-full border transition-colors duration-300',
                          last ? 'border-text bg-text' : 'border-ink bg-white data-active:bg-lavender-grey',
                        ]}
                        aria-hidden="true"
                        data-node
                      ></span>
                      <span class:list={['text-lg leading-snug lg:text-xl', last && 'font-medium']}>{step}</span>
                    </li>
                  );
                })}
                <span
                  class="pointer-events-none absolute top-0 left-0 size-3 rounded-full bg-ink opacity-0"
                  aria-hidden="true"
                  data-dot
                ></span>
              </ol>

              <dl class="grid grid-cols-2 content-start gap-6 border-t border-text pt-6 lg:grid-cols-1 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
                <div class="flex flex-col gap-1.5">
                  <dt class="eyebrow">Manually</dt>
                  <dd class="font-serif text-[2rem] leading-none text-almond-ink lg:text-[2.5rem]">{flow.manual}</dd>
                </div>
                <div class="flex flex-col gap-1.5">
                  <dt class="eyebrow">Automated</dt>
                  <dd class="font-serif text-[2rem] leading-none text-ink lg:text-[2.5rem]">{flow.automated}</dd>
                </div>
                <div class="col-span-2 flex flex-col gap-1.5 lg:col-span-1">
                  <dt class="eyebrow">Result</dt>
                  <dd class="text-lg leading-snug">{flow.result}</dd>
                </div>
              </dl>
            </div>
          </div>
        ))
      }
      <p class="mt-3 text-xs text-muted">Example timings.</p>
    </div>
  </div>
</section>
