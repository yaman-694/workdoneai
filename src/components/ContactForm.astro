---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import Icon from './ui/Icon.astro';
import SelectField from './ui/SelectField.astro';
import { callTimeField, industryField, manualEnquiriesField, teamSizeField } from '../data/contact-form';

const contactFields = [
  { name: 'name', label: 'Your name', type: 'text', autocomplete: 'name', required: true, placeholder: undefined },
  { name: 'email', label: 'Work email', type: 'email', autocomplete: 'email', required: true, placeholder: undefined },
  { name: 'whatsapp', label: 'WhatsApp number (optional)', type: 'tel', autocomplete: 'tel', required: false, placeholder: '+91 98765 43210' },
  { name: 'company', label: 'Company name', type: 'text', autocomplete: 'organization', required: true, placeholder: undefined },
] as const;
---

<form class="flex flex-col gap-5" action="/api/contact" method="post" novalidate data-contact-form>
  <p class="font-serif text-h4">Let's talk about your workflow.</p>
  {
    contactFields.map((field) => (
      <label class="flex flex-col gap-2 text-sm">
        {field.label}
        <input
          type={field.type}
          name={field.name}
          autocomplete={field.autocomplete}
          required={field.required}
          placeholder={field.placeholder}
          class="field min-h-12"
        />
      </label>
    ))
  }
  <div class="grid gap-5 sm:grid-cols-2">
    <SelectField field={industryField} />
    <SelectField field={teamSizeField} />
  </div>
  <SelectField field={manualEnquiriesField} />
  <SelectField field={callTimeField} otherTarget="callTimeOther" />
  <label class="flex flex-col gap-2 text-sm" hidden data-other-field="callTimeOther">
    Your preferred time (IST)
    <input type="text" name="callTimeOther" disabled placeholder="e.g. Saturday morning" class="field min-h-12" />
  </label>
  <label class="flex flex-col gap-2 text-sm">
    Tell us how a normal day runs (optional)
    <textarea
      name="dayToDay"
      rows="4"
      placeholder="e.g. Customers message us on WhatsApp, we note it in Excel, then call them back to confirm..."
      class="field py-3"
    ></textarea>
  </label>
  <!-- Spam trap: real people never see or fill this. -->
  <label class="hidden" aria-hidden="true">
    Leave empty
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </label>
  <!--
    Cloudflare Turnstile bot check. It has no height unless Cloudflare needs the visitor to click,
    so -mt-5 cancels the form gap until the widget turns interactive.
  -->
  <div class="-mt-5 data-interactive:mt-0" data-turnstile data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}></div>
  <button type="submit" class="btn btn-dark self-stretch sm:self-start" data-submit>
    Book my free call
    <Icon name="arrow-right" size={18} />
  </button>
  <p class="min-h-6 text-[0.9375rem]" role="status" aria-live="polite" data-form-status></p>
</form>
